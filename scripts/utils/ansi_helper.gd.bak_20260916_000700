class_name AnsiHelper
extends RefCounted

## 暗黑破坏神2 LPC / MUD ANSI 色彩与图标协议解码引擎
## 移植并深度对齐 Flutter 实现 (fengqi_mud/lib/widgets/ansi_text.dart)
## 支持：
## 1. 16 色、256 色、RGB 模式、[f#RRGGBB]m 24位色与 MUD 色彩宏
## 2. 协议图标标签解析：\x1b[i:<path>] (内嵌小图标)、\x1b[img:<path>] (卡片大图与孔位)
## 3. 全路径容错暗黑2物品纹理加载引擎 (支持 .lowend.png、带参 ?sock=、纯文件名匹配)

const ANSI_16_COLORS = {
	30: "#000000", # 黑色
	31: "#ef4444", # 红色
	32: "#22c55e", # 绿色 (HIG 亮绿)
	33: "#eab308", # 黄色 (HIY 亮黄)
	34: "#3b82f6", # 蓝色
	35: "#a855f7", # 紫色 / 品红
	36: "#06b6d4", # 青色 (HIC 亮青)
	37: "#f8fafc", # 白色
}

# 静态缓存物品文件名到真实 res://assets/items/... 路径的快速映射
static var _item_path_cache: Dictionary = {}
static var _cache_initialized: bool = false

## 安全转换任何 Variant 为 int，杜绝 null 导致的 Nonexistent 'int' constructor 异常
static func to_safe_int(val: Variant, default_val: int = 0) -> int:
	if val == null:
		return default_val
	if val is int:
		return val
	if val is float:
		return int(val)
	if val is String:
		if val.is_valid_int():
			return val.to_int()
		if val.is_valid_float():
			return int(val.to_float())
	if val is bool:
		return 1 if val else 0
	return default_val

## 预处理 MUD 常用色彩宏与换行符
static func preprocess_mud_macros(text: String) -> String:
	var esc = char(27)
	var s = text.replace("$br#", "\n")
	s = s.replace("NOR", esc + "[0m")
	s = s.replace("BLK", esc + "[30m")
	s = s.replace("RED", esc + "[31m")
	s = s.replace("GRN", esc + "[32m")
	s = s.replace("YEL", esc + "[33m")
	s = s.replace("BLU", esc + "[34m")
	s = s.replace("MAG", esc + "[35m")
	s = s.replace("CYN", esc + "[36m")
	s = s.replace("WHT", esc + "[37m")
	s = s.replace("HIR", esc + "[1;31m")
	s = s.replace("HIG", esc + "[1;32m")
	s = s.replace("HIY", esc + "[1;33m")
	s = s.replace("HIB", esc + "[1;34m")
	s = s.replace("HIM", esc + "[1;35m")
	s = s.replace("HIC", esc + "[1;36m")
	s = s.replace("HIW", esc + "[1;37m")
	return s

## 剥离嵌入在文本中的自定义协议标签 (\x1b[i:...]、\x1b[img:...]、\x1b[u:...] 等)
static func strip_custom_tags(text: String) -> String:
	var esc = char(27)
	var regex = RegEx.new()
	regex.compile("(?:" + esc + "\\[|\\[)(?:i|img|u|s):[^\\]]*\\]")
	return regex.sub(text, "", true)

## 从文本中提取内嵌小图标路径 (\x1b[i:<path>])
static func extract_icon_path(raw_text: String) -> String:
	if raw_text.is_empty():
		return ""
	var esc = char(27)
	var regex = RegEx.new()
	regex.compile("(?:" + esc + "\\[|\\[)i:([^\\]]+)\\]")
	var m = regex.search(raw_text)
	if m:
		return m.get_string(1).strip_edges()
	return ""

## 从文本中提取卡片大图与凹槽信息 (\x1b[img:<path>?sock=4&inlays=r1,r2])
static func extract_img_info(raw_text: String) -> Dictionary:
	var res = { "path": "", "sock": 0, "inlays": [] }
	if raw_text.is_empty():
		return res
	var esc = char(27)
	var regex = RegEx.new()
	regex.compile("(?:" + esc + "\\[|\\[)img:([^\\]]+)\\]")
	var m = regex.search(raw_text)
	if m:
		var raw_path = m.get_string(1).strip_edges()
		if "?" in raw_path:
			var parts = raw_path.split("?")
			res["path"] = parts[0].strip_edges()
			var query = parts[1]
			for pair in query.split("&"):
				var kv = pair.split("=")
				if kv.size() == 2:
					if kv[0] == "sock":
						res["sock"] = int(kv[1])
					elif kv[0] == "inlays":
						res["inlays"] = Array(kv[1].split(","))
		else:
			res["path"] = raw_path
	return res

## 将 ANSI 编码转换为 Godot 原生 BBCode (用于 RichTextLabel)
static func to_bbcode(raw_text: String) -> String:
	if raw_text.is_empty():
		return ""
		
	var text = preprocess_mud_macros(raw_text)
	text = text.replace("<center>", "[center]").replace("</center>", "[/center]")
	text = strip_custom_tags(text)
	var esc = char(27)
	
	var regex = RegEx.new()
	var pattern = "(?:" + esc + "\\[|\\[)([0-9;]+)m|(?:" + esc + "\\[|\\[)([fFbB]#[0-9a-fA-F]{6})m?"
	regex.compile(pattern)
	
	var matches = regex.search_all(text)
	if matches.is_empty():
		return text
		
	var result = ""
	var last_pos = 0
	var color_stack_count = 0
	
	for m in matches:
		var start_idx = m.get_start()
		if start_idx > last_pos:
			result += text.substr(last_pos, start_idx - last_pos)
			
		var ansi_codes_str = m.get_string(1)
		var hex_color_str = m.get_string(2)
		
		if not hex_color_str.is_empty():
			var clean_hex = hex_color_str.substr(2)
			result += "[color=#%s]" % clean_hex
			color_stack_count += 1
		elif not ansi_codes_str.is_empty():
			var parts = ansi_codes_str.split(";")
			if parts.size() >= 3 and parts[0] == "38" and parts[1] == "5":
				var c_idx = int(parts[2])
				var hex = _get_256_color_hex(c_idx)
				result += "[color=%s]" % hex
				color_stack_count += 1
			elif parts.size() >= 5 and parts[0] == "38" and parts[1] == "2":
				var r = int(parts[2])
				var g = int(parts[3])
				var b = int(parts[4])
				result += "[color=#%02x%02x%02x]" % [r, g, b]
				color_stack_count += 1
			else:
				for p in parts:
					var code = int(p)
					if code == 0:
						while color_stack_count > 0:
							result += "[/color]"
							color_stack_count -= 1
					elif ANSI_16_COLORS.has(code):
						result += "[color=%s]" % ANSI_16_COLORS[code]
						color_stack_count += 1
			
		last_pos = m.get_end()
		
	if last_pos < text.length():
		result += text.substr(last_pos)
		
	while color_stack_count > 0:
		result += "[/color]"
		color_stack_count -= 1
		
	return result

## 剥离全部 ANSI、MUD 颜色标签与控制字符，输出绝对纯文本
static func to_plain_text(raw_text: String) -> String:
	if raw_text.is_empty():
		return ""
		
	var text = preprocess_mud_macros(raw_text)
	text = strip_custom_tags(text)
	var esc = char(27)
	
	# 1. 剥离所有协议前缀标签 [i:...], [img:...]
	var regex_proto = RegEx.new()
	regex_proto.compile("(?:" + esc + "\\[|\\[)[a-zA-Z]:[^\\]]*\\]")
	text = regex_proto.sub(text, "", true)
	
	# 2. 剥离 ANSI 颜色码与控制序列: [f#...], [F#...], [0m, [2;37;0m 等
	var regex_ansi = RegEx.new()
	regex_ansi.compile("(?:" + esc + "\\[|\\[)[0-9;]*[a-zA-Z]|(?:" + esc + "\\[|\\[)[fFbB]#[0-9a-fA-F]{6}m?")
	text = regex_ansi.sub(text, "", true)
	
	# 3. 兜底清除遗留的纯颜色残余码，如 #[0-9a-fA-F]{6}m
	var regex_residual = RegEx.new()
	regex_residual.compile("#[0-9a-fA-F]{6}m?")
	text = regex_residual.sub(text, "", true)
	
	# 4. 彻底剥除裸转义符与多余中括号序列
	var regex_brackets = RegEx.new()
	regex_brackets.compile("\\[[0-9;]+m")
	text = regex_brackets.sub(text, "", true)
	text = text.replace(esc, "")
	
	return text.strip_edges()

## 256 色索引转十六进制颜色 (对齐 Flutter 6x6x6 立方体算法)
static func _get_256_color_hex(code: int) -> String:
	if code < 8:
		return ANSI_16_COLORS.get(30 + code, "#ffffff")
	elif code < 16:
		return ANSI_16_COLORS.get(30 + (code % 8), "#ffffff")
	elif code < 232:
		var c = code - 16
		var r = int(c / 36)
		var g = int((c % 36) / 6)
		var b = c % 6
		var r_val = 0 if r == 0 else (r * 40 + 55)
		var g_val = 0 if g == 0 else (g * 40 + 55)
		var b_val = 0 if b == 0 else (b * 40 + 55)
		return "#%02x%02x%02x" % [r_val, g_val, b_val]
	else:
		var gray = (code - 232) * 10 + 8
		return "#%02x%02x%02x" % [gray, gray, gray]

## -------------------------------------------------------------
## 强韧暗黑2物品纹理加载引擎 (100% 容错，支持 .lowend.png 与全路径归一化)
## -------------------------------------------------------------
static func load_item_texture(raw_path: String) -> Texture2D:
	if raw_path.is_empty():
		return null
		
	# 1. 剥离 ?sock= 等查询参数
	var clean = raw_path
	if "?" in clean:
		clean = clean.split("?")[0].strip_edges()
		
	# 2. 移除 Flutter / MUD 前缀
	clean = clean.replace("assets/images/", "").replace("assets/", "")
	if clean.begins_with("items/"):
		clean = clean.substr(6)
	clean = clean.replace("\\", "/")
	
	# 3. 构造直接尝试候选列表
	var candidates: Array[String] = [
		"res://assets/items/" + clean,
		"res://assets/items/" + clean.replace(".png", ".lowend.png"),
		"res://assets/items/" + clean + ".lowend.png",
		"res://assets/items/" + clean + ".png"
	]
	
	for cand in candidates:
		if ResourceLoader.exists(cand):
			return load(cand)
			
	# 4. 若直连未命中，进行智能词根/文件名索引
	_init_item_cache_if_needed()
	var base_name = clean.get_file().to_lower()
	var base_stem = base_name.replace(".lowend.png", "").replace(".png", "")
	
	if _item_path_cache.has(base_name):
		var target_res = _item_path_cache[base_name]
		if ResourceLoader.exists(target_res):
			return load(target_res)
			
	if _item_path_cache.has(base_stem):
		var target_res = _item_path_cache[base_stem]
		if ResourceLoader.exists(target_res):
			return load(target_res)
			
	return null

## 递归扫描本地 res://assets/items 构建索引字典
static func _init_item_cache_if_needed() -> void:
	if _cache_initialized:
		return
	_cache_initialized = true
	_scan_dir_for_cache("res://assets/items")

static func _scan_dir_for_cache(dir_path: String) -> void:
	var dir = DirAccess.open(dir_path)
	if not dir:
		return
	dir.list_dir_begin()
	var file_name = dir.get_next()
	while file_name != "":
		if dir.current_is_dir() and not file_name.begins_with("."):
			_scan_dir_for_cache(dir_path + "/" + file_name)
		elif file_name.ends_with(".png"):
			var full_res_path = dir_path + "/" + file_name
			var f_lower = file_name.to_lower()
			_item_path_cache[f_lower] = full_res_path
			var stem = f_lower.replace(".lowend.png", "").replace(".png", "")
			if not _item_path_cache.has(stem):
				_item_path_cache[stem] = full_res_path
		file_name = dir.get_next()
