var current_act_key: String = "act1"
var current_room_name: String = "罗格营地"
var current_player_diff: String = "normal" # 玩家当前难度
var selected_diff_filter: String = "all" # 英雄列表难度筛选: all, normal, nm, hell
var room_players: Array = [] # 当前场景的所有在线英雄列表
var gold_amount: int = 0

func _ready() -> void:
	_init_player_ui()
	_connect_signals()
	
	var init_town = "罗格营地"
	if GameState.current_town_name != "":
		init_town = GameState.current_town_name
	elif GameState.current_stage_info is Dictionary and GameState.current_stage_info.has("act"):
		var act_num = _safe_int(GameState.current_stage_info.get("act"), 1)
		if act_num == 1: init_town = "罗格营地"
		elif act_num == 2: init_town = "鲁高因"
		elif act_num == 3: init_town = "库拉斯特"
		elif act_num == 4: init_town = "群魔堡垒"
		elif act_num == 5: init_town = "哈洛加斯"
	_update_town_display(init_town)
	
	# 回放全局公频聊天历史 (保证从战斗切回大本营时不丢消息)
	if chat_log:
		for hist_msg in GameState.chat_history:
			_append_chat(hist_msg, "", false)
	
	# 向 LPC 请求刷新当前大本营与全量数据 (包含人物属性、金币与专属背包帧)
	_request_lpc_sync()
	if not NetworkClient.is_connected and NetworkClient.has_signal("connected_to_server"):
		NetworkClient.connected_to_server.connect(_request_lpc_sync, CONNECT_ONE_SHOT)

	_show_toast("已进驻安全大本营！这里可自由组队、交易与聊天")

func _request_lpc_sync() -> void:
	if NetworkClient.is_connected:
		print("[TownHub] 正在向 LPC 发送 look, ghp1, gscore, gbag 1, stage 初始化同步指令...")
		NetworkClient.send_raw("look")
		NetworkClient.send_raw("ghp1")
		NetworkClient.send_raw("gscore")
		NetworkClient.send_raw("gbag 1")
		NetworkClient.send_raw("stage")

func _init_player_ui() -> void:
	var cdata = GameState.selected_character
	if not cdata.is_empty():
		var cname = str(cdata.get("name", "英雄"))
		var cls = str(cdata.get("class", "sor"))
		var cls_name = str(cdata.get("class_name", GameState.get_class_display_name(cls)))
		var level = _safe_int(cdata.get("level"), 1)
		
		# 难度判定：优先采用 GameState.selected_difficulty，若为空才从 cdata 读取
		var target_diff = GameState.selected_difficulty
		if target_diff.is_empty():
			target_diff = str(cdata.get("difficulty", "normal")).to_lower()
		current_player_diff = parse_difficulty_code(target_diff)
		cdata["difficulty"] = current_player_diff
		GameState.selected_difficulty = current_player_diff
		
		var diff_info = get_difficulty_display(current_player_diff)
		var diff_name = str(diff_info.get("name", "普通"))
		lbl_char_name.text = cname
		lbl_char_class.text = "Lv.%d %s [%s]" % [level, cls_name, diff_name]
		avatar_icon.texture = get_hero_avatar_icon(cls)
		
		gold_amount = _safe_int(cdata.get("gold"), 0)
		lbl_gold.text = "🪙 金币: %d" % gold_amount
		if inventory_panel and inventory_panel.has_method("update_gold"):
			inventory_panel.update_gold(gold_amount)

func _connect_signals() -> void:
	# 出征与大本营设施
	btn_go_battle.pressed.connect(_on_enter_battle_pressed)
	btn_stash.pressed.connect(func(): NetworkClient.send_raw("open stash"))
	btn_waypoint.pressed.connect(_toggle_world_map)
	btn_cube.pressed.connect(_toggle_cube_panel)
	
	# 聊天输入与超链接点击
	chat_input.text_submitted.connect(_on_chat_submitted)
	btn_chat_send.pressed.connect(func(): _on_chat_submitted(chat_input.text))
	chat_log.meta_clicked.connect(_on_chat_meta_clicked)
	if chat_input.has_signal("item_dropped"):
		chat_input.item_dropped.connect(_insert_item_to_chat)
	
	# 难度过滤标签
	btn_filter_all.pressed.connect(func(): _set_diff_filter("all"))
	btn_filter_normal.pressed.connect(func(): _set_diff_filter("normal"))
	btn_filter_nm.pressed.connect(func(): _set_diff_filter("nm"))
	btn_filter_hell.pressed.connect(func(): _set_diff_filter("hell"))
	
	# 顶部快捷栏
	btn_top_rank.pressed.connect(_open_leaderboard)
	btn_close_rank.pressed.connect(_close_leaderboard)
	btn_top_exit.pressed.connect(_on_exit_to_login)
	
	# 右侧边栏与折叠按钮初始化
	if btn_toggle_sidebar:
		_setup_toggle_button_style()
		btn_toggle_sidebar.pressed.connect(toggle_sidebar)

	# 背包体系 (gbag 驱动，常驻侧边栏)
	if inventory_panel:
		inventory_panel.item_hovered.connect(func(item_data, pos):
			if item_tooltip:
				item_tooltip.show_item(item_data, pos)
		)
		inventory_panel.item_unhovered.connect(func():
			if item_tooltip:
				item_tooltip.hide_tooltip()
		)
		if inventory_panel.little_pocket_panel:
			inventory_panel.little_pocket_panel.visibility_changed.connect(func():
				if inventory_panel.little_pocket_panel.visible:
					# 单窗口互斥: 打开小口袋时，自动互斥关闭纸娃娃、魔盒、工坊与随身商店等
					_close_all_popups_except(inventory_panel.little_pocket_panel)
			)
		if inventory_panel.socketing_workbench_panel:
			inventory_panel.socketing_workbench_panel.visibility_changed.connect(func():
				if inventory_panel.socketing_workbench_panel.visible:
					# 单窗口互斥: 打开工坊时，自动互斥关闭纸娃娃、魔盒、小口袋与随身商店等
					_close_all_popups_except(inventory_panel.socketing_workbench_panel)
			)

	# 控制矩阵快捷菜单 (背包下方挂机房同款)
	if control_matrix:
		control_matrix.btn_character_clicked.connect(_toggle_character_info)
		control_matrix.btn_skills_clicked.connect(_toggle_skill_panel)
		control_matrix.btn_craft_clicked.connect(_toggle_cube_panel)
		control_matrix.btn_pickup_clicked.connect(_toggle_pickup_setting)
		control_matrix.btn_smelt_clicked.connect(func(): NetworkClient.send_raw("gfenjie all"))
		control_matrix.btn_shop_clicked.connect(_toggle_gshop_panel)
		control_matrix.btn_reset_points_clicked.connect(func(): NetworkClient.send_raw("reset"))
		control_matrix.btn_hook_clicked.connect(func(): _show_toast("当前在安全大本营，出征野外后可开启挂机战斗！"))
		control_matrix.btn_exit_clicked.connect(_on_exit_to_login)
	
	# 初始化大地图选点出征
	if world_map:
		world_map.hide()
		world_map.enter_spot.connect(_on_map_spot_selected)
		world_map.closed.connect(func():
			world_map.hide()
		)

	# 初始化角色信息面板
	if char_info_panel:
		char_info_panel.hide()
		if char_info_panel.has_signal("item_hovered") and item_tooltip:
			char_info_panel.item_hovered.connect(func(item_data, pos):
				item_tooltip.show_item(item_data, pos)
			)
			char_info_panel.item_unhovered.connect(func():
				item_tooltip.hide_tooltip()
			)

	# 初始化技能面板
	if skill_panel:
		skill_panel.hide()
		skill_panel.skill_learn_requested.connect(func(code: String):
			if NetworkClient.is_connected:
				NetworkClient.send_raw("glearn " + code)
		)
		skill_panel.skill_reset_requested.connect(func():
			if NetworkClient.is_connected:
				NetworkClient.send_raw("gresetskill")
		)
		skill_panel.skill_set_binding_requested.connect(func(code: String, slot: String):
			if NetworkClient.is_connected:
				NetworkClient.send_raw("gsetskill %s %s" % [code, slot])
		)

	# 初始化方块面板
	if cube_panel == null:
		cube_panel = AFK_CubePanel.new()
		cube_panel.z_index = 150
		add_child(cube_panel)
		cube_panel.visible = false
		cube_panel.action_requested.connect(func(cmd: String):
			if NetworkClient.is_connected:
				NetworkClient.send_raw(cmd)
		)
		cube_panel.item_hovered.connect(func(item_data, pos):
			if item_tooltip:
				item_tooltip.show_item(item_data, pos)
		)
		cube_panel.item_unhovered.connect(func():
			if item_tooltip:
				item_tooltip.hide_tooltip()
		)

	# 初始化随身商店面板
	if gshop_panel == null:
		gshop_panel = GShopPanelScript.new()
		gshop_panel.z_index = 150
		add_child(gshop_panel)
		gshop_panel.visible = false
		gshop_panel.item_hovered.connect(func(item_data, pos):
			if item_tooltip:
				item_tooltip.show_item(item_data, pos)
		)
		gshop_panel.item_unhovered.connect(func():
			if item_tooltip:
				item_tooltip.hide_tooltip()
		)

	# 初始化拾取设置面板
	if pickup_setting_panel:
		pickup_setting_panel.hide()

	# 网络帧监听
	NetworkClient.json_frame_received.connect(_on_json_frame_received)
	NetworkClient.text_received.connect(_on_text_received)

func _setup_toggle_button_style() -> void:
	if not btn_toggle_sidebar:
		return
	var style = StyleBoxFlat.new()
	style.bg_color = Color(0.08, 0.08, 0.09, 0.92)
	style.border_width_left = 1
	style.border_width_top = 1
	style.border_width_bottom = 1
	style.border_width_right = 0
	style.border_color = Color(0.35, 0.3, 0.2, 0.8)
	style.corner_radius_top_left = 4
	style.corner_radius_bottom_left = 4
	btn_toggle_sidebar.add_theme_stylebox_override("normal", style)
	
	var hover = style.duplicate()
	hover.border_color = Color(0.9, 0.8, 0.3, 1.0)
	hover.bg_color = Color(0.14, 0.14, 0.16, 0.98)
	btn_toggle_sidebar.add_theme_stylebox_override("hover", hover)
	btn_toggle_sidebar.add_theme_color_override("font_color", Color(0.9, 0.8, 0.4, 1))

func toggle_sidebar() -> void:
	set_sidebar_expanded(not is_sidebar_expanded)

func set_sidebar_expanded(expand: bool) -> void:
	is_sidebar_expanded = expand
	if right_sidebar:
		right_sidebar.visible = is_sidebar_expanded
		
	if is_sidebar_expanded:
		# 展开侧栏时主动同步拉取当前页背包数据
		if NetworkClient.is_connected and inventory_panel:
			NetworkClient.send_raw("gbag %d" % inventory_panel.current_page)
	else:
		# 如果折叠收起，同时隐藏小口袋与悬浮窗
		if inventory_panel and inventory_panel.little_pocket_panel:
			inventory_panel.little_pocket_panel.hide()
		if item_tooltip:
			item_tooltip.hide_tooltip()

	_update_toggle_button_position()
	# 魔盒与商店浮窗跟随侧栏开合重新贴位
	if cube_panel and cube_panel.visible:
		_position_cube_panel()
	if gshop_panel and gshop_panel.visible:
		_position_gshop_panel()

func _update_toggle_button_position() -> void:
	if not btn_toggle_sidebar:
		return
	if is_sidebar_expanded:
		btn_toggle_sidebar.text = "▶"
		btn_toggle_sidebar.offset_left = -318.0
		btn_toggle_sidebar.offset_right = -302.0
	else:
		btn_toggle_sidebar.text = "◀"
		btn_toggle_sidebar.offset_left = -16.0
		btn_toggle_sidebar.offset_right = 0.0

## 互斥关闭所有弹出视窗 (除 keep_node 外)
## 重点：绝不关闭背包和右侧侧边栏！背包常驻侧栏供随时整装
func _close_all_popups_except(keep_node: Node = null) -> void:
	if leaderboard_modal and leaderboard_modal != keep_node: leaderboard_modal.visible = false
	if char_info_panel and char_info_panel != keep_node:
		if char_info_panel.has_method("close"): char_info_panel.close()
		else: char_info_panel.hide()
	if skill_panel and skill_panel != keep_node:
		if skill_panel.has_method("close"): skill_panel.close()
		else: skill_panel.hide()
	if cube_panel and cube_panel != keep_node: cube_panel.visible = false
	if gshop_panel and gshop_panel != keep_node: gshop_panel.close()
	if world_map and world_map != keep_node: world_map.hide()
	if pickup_setting_panel and pickup_setting_panel != keep_node:
		if pickup_setting_panel.has_method("hide_panel"): pickup_setting_panel.hide_panel()
		else: pickup_setting_panel.hide()
	if inventory_panel:
		if inventory_panel.little_pocket_panel and inventory_panel.little_pocket_panel != keep_node:
			inventory_panel.little_pocket_panel.hide()
		if inventory_panel.socketing_workbench_panel and inventory_panel.socketing_workbench_panel != keep_node:
			inventory_panel.socketing_workbench_panel.close()
	if item_tooltip: item_tooltip.hide_tooltip()

## 开关右侧边栏背包 (完全由 LPC gbag 协议驱动)
func _toggle_inventory() -> void:
	toggle_sidebar()
	if is_sidebar_expanded and NetworkClient.is_connected and inventory_panel:
		NetworkClient.send_raw("gbag %d" % inventory_panel.current_page)

## 开关大地图 (选点出征)
func _toggle_world_map() -> void:
	if not world_map: return
	if world_map.visible:
		world_map.hide()
	else:
		_close_all_popups_except(world_map)
		if NetworkClient.is_connected:
			NetworkClient.send_raw("stage")
		world_map.z_index = 200
		world_map.update_progress(GameState.player_max_stage)
		world_map.show()

## 大地图选点切关并出征进入野外战斗
func _on_map_spot_selected(arg1: Variant, arg2: Variant = null) -> void:
	var stage_id: int = 1
	var s_name: String = ""
	if arg1 is Dictionary:
		stage_id = _safe_int(arg1.get("stage_id"), 1)
		s_name = str(arg1.get("name", ""))
	elif arg1 is int or arg1 is float:
		stage_id = int(arg1)
		if arg2 != null:
			s_name = str(arg2)
	
	if GameState.is_in_team and not GameState.is_team_leader():
		_show_toast("当前正处于队伍中，仅队长可带领全队选择关卡出征！")
		return
	_show_toast("出征【%s】！踏入野外战场..." % s_name)
	if NetworkClient.is_connected:
		NetworkClient.send_raw("stage %d" % stage_id)
	if world_map:
		world_map.hide()
	await get_tree().create_timer(0.2).timeout
	get_tree().change_scene_to_file("res://scenes/afk/afk_main_hud.tscn")

## 开关角色属性面板 (纸娃娃)
func _toggle_character_info() -> void:
	if not char_info_panel: return
	if char_info_panel.visible:
		if char_info_panel.has_method("close"): char_info_panel.close()
		else: char_info_panel.hide()
	else:
		# 若侧栏处于收起状态，自动展开以支持即时整装
		if not is_sidebar_expanded:
			set_sidebar_expanded(true)
		# 单窗口互斥: 关小口袋、魔盒与随身商店
		if inventory_panel and inventory_panel.little_pocket_panel:
			inventory_panel.little_pocket_panel.hide()
		if cube_panel and cube_panel.visible:
			cube_panel.visible = false
		if gshop_panel and gshop_panel.visible:
			gshop_panel.close()
		_close_all_popups_except(char_info_panel)
		if char_info_panel.has_method("open"): char_info_panel.open()
		else: char_info_panel.show()
		if NetworkClient.is_connected:
			NetworkClient.send_raw("gscore")
			NetworkClient.send_raw("look")

## 开关技能树面板
func _toggle_skill_panel() -> void:
	if not skill_panel: return
	if skill_panel.visible:
		if skill_panel.has_method("close"): skill_panel.close()
		else: skill_panel.hide()
	else:
		_close_all_popups_except(skill_panel)
		if skill_panel.has_method("open"): skill_panel.open()
		else: skill_panel.show()
		if NetworkClient.is_connected:
			NetworkClient.send_raw("gskills")

## 开关魔盒/方块面板
func _toggle_cube_panel() -> void:
	if not cube_panel: return
	if cube_panel.visible:
		cube_panel.visible = false
	else:
		# 若侧栏处于收起状态，自动展开
		if not is_sidebar_expanded:
			set_sidebar_expanded(true)
		# 单窗口互斥: 关纸娃娃、小口袋与随身商店
		if char_info_panel and char_info_panel.visible:
			if char_info_panel.has_method("close"): char_info_panel.close()
			else: char_info_panel.hide()
		if inventory_panel and inventory_panel.little_pocket_panel:
			inventory_panel.little_pocket_panel.hide()
		if gshop_panel and gshop_panel.visible:
			gshop_panel.close()
		_close_all_popups_except(cube_panel)
		cube_panel.visible = true
		_position_cube_panel()
		if NetworkClient.is_connected:
			NetworkClient.send_raw("gcube")

func _position_cube_panel() -> void:
	if cube_panel == null or not cube_panel.visible: return
	# 侧栏展开时让开侧栏宽度 (约 320px), 折叠时贴屏幕右缘
	var right_margin := 336.0 if is_sidebar_expanded else 16.0
	var x := size.x - right_margin - cube_panel.size.x
	var y := (size.y - cube_panel.size.y) * 0.5
	cube_panel.position = Vector2(max(10.0, x), max(10.0, y))

## 开关随身补给商店
func _toggle_gshop_panel() -> void:
	if not gshop_panel: return
	if gshop_panel.visible:
		gshop_panel.close()
	else:
		# 若侧栏处于收起状态，自动展开以支持即时整装
		if not is_sidebar_expanded:
			set_sidebar_expanded(true)
		# 单窗口互斥: 关纸娃娃、小口袋、魔盒
		if char_info_panel and char_info_panel.visible:
			if char_info_panel.has_method("close"): char_info_panel.close()
			else: char_info_panel.hide()
		if inventory_panel and inventory_panel.little_pocket_panel:
			inventory_panel.little_pocket_panel.hide()
		if cube_panel and cube_panel.visible:
			cube_panel.visible = false
		_close_all_popups_except(gshop_panel)
		gshop_panel.open()
		_position_gshop_panel()

func _position_gshop_panel() -> void:
	if gshop_panel == null or not gshop_panel.visible: return
	var right_margin: float = 336.0 if is_sidebar_expanded else 16.0
	var x: float = float(size.x) - right_margin - float(gshop_panel.size.x)
	var y: float = (float(size.y) - float(gshop_panel.size.y)) * 0.5
	gshop_panel.position = Vector2(max(10.0, x), max(10.0, y))

## 开关拾取设置面板
func _toggle_pickup_setting() -> void:
	if not pickup_setting_panel: return
	if pickup_setting_panel.visible:
		if pickup_setting_panel.has_method("hide_panel"): pickup_setting_panel.hide_panel()
		else: pickup_setting_panel.hide()
	else:
		_close_all_popups_except(pickup_setting_panel)
		if pickup_setting_panel.has_method("show_panel"): pickup_setting_panel.show_panel()
		else: pickup_setting_panel.show()
		if NetworkClient.is_connected:
			NetworkClient.send_raw("gfenjie get")

## 处理服务端推送的各类数据包
func _on_json_frame_received(type: String, data: Variant) -> void:
	# 0. LPC 专属大地图关卡进度帧 (stage_info)
	if type == "stage_info" and data is Dictionary:
		var max_s = _safe_int(data.get("max_stage"), 0)
		GameState.player_max_stage = max_s
		if data.has("worlds") and data["worlds"] is Array:
			GameState.unlocked_worlds = data["worlds"]
		if data.has("selected_stage"):
			GameState.selected_stage_id = _safe_int(data.get("selected_stage"), 1)
		if data.has("selected_act"):
			GameState.selected_act = str(data.get("selected_act", "act1"))
		print("[TownHub] 收到关卡进度更新: max_stage = %d, selected = %d (%s), worlds = %d" % [max_s, GameState.selected_stage_id, GameState.selected_act, GameState.unlocked_worlds.size()])
		if world_map:
			world_map.update_progress(max_s)

	# 1. 房间标题 (罗格营地 / 鲁高因 等)
	elif type == "title":
		var raw_title = ""
		if data is Dictionary:
			raw_title = str(data.get("name", ""))
		elif data is String:
			raw_title = data
		_update_town_act(raw_title)

	# 1.1 离开挂机位面回营广播 (stage_leave)
	elif type == "stage_leave":
		var t_name = "罗格营地"
		var act_id = "act1"
		if data is Dictionary:
			t_name = str(data.get("town_name", data.get("town", "罗格营地")))
			act_id = str(data.get("act_id", "act1"))
		elif data is String:
			for part in data.split(","):
				if part.begins_with("town_name:"):
					t_name = part.substr(10)
				elif part.begins_with("town:"):
					t_name = part.substr(5)
				elif part.begins_with("act_id:"):
					act_id = part.substr(7)
		GameState.current_town_name = t_name
		GameState.current_location_act = act_id
		_update_town_display(t_name)
		
	# 2. 房间内的出口与同场景英雄列表 (LPC 在 exits 帧下发 type == "hero" 的真实玩家)
	elif type == "exits":
		if data is Array:
			_parse_room_players(data)
			
	# 3. 房间内的对象列表 (对齐Flutter：绝不直接覆盖清空英雄列表)
	elif type == "objects":
		if data is Array:
			var has_any_hero = false
			for it in data:
				if it is Dictionary and str(it.get("type", "")) == "hero":
					has_any_hero = true
					break
			if has_any_hero:
				_parse_room_players(data)
				
	# 3.5 实时增量进出监听 (当其他玩家登录进房或出征离开时，自动刷新房间英雄)
	elif type == "object" or type == "object_remove":
		if NetworkClient.is_connected:
			_request_refresh_room()
			
	# 3.8 难度切换监听 (difficulty_change)
	elif type == "difficulty_change":
		if data is Dictionary and data.has("difficulty"):
			var new_diff = parse_difficulty_code(str(data["difficulty"]))
			current_player_diff = new_diff
			GameState.selected_difficulty = new_diff
			if GameState.selected_character is Dictionary:
				GameState.selected_character["difficulty"] = new_diff
			_init_player_ui()
			_request_refresh_room()
			var d_info = get_difficulty_display(new_diff)
			_show_toast("当前世界难度已切换为: " + str(d_info.get("name", "普通")))

	# 4. 角色血量/金币/等级/经验/难度
	elif type == "status" or type == "charhp":
		if data is Dictionary:
			if data.has("difficulty"):
				var new_diff = parse_difficulty_code(str(data["difficulty"]))
				current_player_diff = new_diff
				GameState.selected_difficulty = new_diff
				if GameState.selected_character is Dictionary:
					GameState.selected_character["difficulty"] = new_diff
				_init_player_ui()
			if data.has("gold"):
				gold_amount = int(data["gold"])
				lbl_gold.text = "🪙 金币: %d" % gold_amount
				if inventory_panel and inventory_panel.has_method("update_gold"):
					inventory_panel.update_gold(gold_amount)
				if gshop_panel and gshop_panel.has_method("update_gold"):
					gshop_panel.update_gold(gold_amount)
			var s_lvl = _safe_int(data.get("lvl"), -1)
			if s_lvl > 0:
				_update_topbar_level(s_lvl)
					
	# 5. LPC 专属背包帧 (gbag: 84格/页, 30页动态扩展, 护身符口袋)
	elif type == "gbag" and data is Dictionary:
		var items_list = data.get("items", [])
		var charm_used = _safe_int(data.get("charm_used_slots"), -1)
		var charm_max = _safe_int(data.get("charm_max_slots"), 40)
		var total_pages = _safe_int(data.get("pages"), 1)
		var cur_page = _safe_int(data.get("page", data.get("current_page")), 1)
		print("[TownHub] 收到 LPC 专属背包帧 gbag: %d 件物品, 护身符口袋: %d/%d, 总页数: %d, 当前页: %d" % [items_list.size(), charm_used, charm_max, total_pages, cur_page])
		if inventory_panel:
			inventory_panel.render_lpc_items(items_list, charm_used, charm_max, total_pages, cur_page, data)

	# 5.1 LPC 专属背包物品增量更新帧 (gbag_item_update: 零重绘局部 -1 或清空格子)
	elif type == "gbag_item_update" and data is Dictionary:
		var fid = str(data.get("file_id", ""))
		var amt = _safe_int(data.get("amount"), 0)
		if inventory_panel and inventory_panel.has_method("update_item_amount"):
			inventory_panel.update_item_amount(fid, amt)

	# 6. LPC 专属频道广播帧 (channel: chat/bill/rumor 等，解决真实联机下聊天视窗空空如也的根因)
	elif type == "channel":
		var channel_text = ""
		if data is Dictionary:
			channel_text = str(data.get("text", data.get("msg", "")))
		elif data is String:
			channel_text = data
		if not channel_text.is_empty():
			_on_text_received(channel_text)

	# 7. LPC 普通文本/富文本/系统反馈帧 (text: 队伍聊天/系统提示/操作报错)
	elif type == "text":
		var plain_or_ansi = ""
		if data is String:
			plain_or_ansi = data
		elif data is Dictionary:
			plain_or_ansi = str(data.get("text", data.get("msg", "")))
		if not plain_or_ansi.is_empty():
			_on_text_received(plain_or_ansi)

	# 8. LPC 复合交互面板帧 (panel: 组队邀请、NPC交互选项、装备词缀卡片)
	elif type == "panel" and data is Dictionary:
		_handle_panel_frame(data)

	# 9. LPC 专属组队更新帧 (team: 队长与队员实时列表及血量)
	elif type == "team" and data is Dictionary:
		var leader_id = str(data.get("leader", ""))
		var raw_m = data.get("members", [])
		var members: Array = raw_m if raw_m is Array else []
		GameState.update_team_data(leader_id, members)
		_render_player_cards() # 重新渲染英雄列表以标记队员徽章与置顶

	# 10. LPC 线性推关进场帧 (stage_enter: 队长带队出征，队员自动协同进入野外战斗)
	elif type == "stage_enter" and data is Dictionary:
		GameState.current_stage_info = data
		var s_name = str(data.get("name", "挂机副本"))
		_show_toast("队长已带领全队踏入【%s】，全队集结出征！" % s_name)
		await get_tree().create_timer(0.2).timeout
		get_tree().change_scene_to_file("res://scenes/afk/afk_main_hud.tscn")

	# 11. LPC 专属全结构化角色属性帧 (gscore)
	elif type == "gscore" and data is Dictionary:
		var g_lvl = _safe_int(data.get("level"), -1)
		var g_name = str(data.get("name", ""))
		if not g_name.is_empty() and lbl_char_name:
			lbl_char_name.text = g_name
		if g_lvl > 0:
			_update_topbar_level(g_lvl)
		if char_info_panel and char_info_panel.has_method("render_gscore_data"):
			char_info_panel.render_gscore_data(data)

	# 11.5 角色升级广播帧 (level_up: 纯后端数据驱动)
	elif type == "level_up" and data is Dictionary:
		var n_lvl = _safe_int(data.get("level"), 1)
		var msg = str(data.get("msg", "恭喜升级！"))
		_show_toast("★★★ %s ★★★" % msg)
		_update_topbar_level(n_lvl)
		NetworkClient.send_raw("gscore")

	# 12. LPC 专属技能树结构化帧 (gskills)
	elif type == "gskills" and data is Dictionary:
		if skill_panel and skill_panel.has_method("render_gskills_data"):
			skill_panel.render_gskills_data(data)

	# 13. LPC 专属方块与合成帧 (gcube)
	elif type == "gcube" and data is Dictionary:
		if cube_panel and cube_panel.has_method("render_gcube_data"):
			cube_panel.render_gcube_data(data)

	# 13.5 LPC 专属凹槽工坊帧 (gsocket)
	elif type == "gsocket" and data is Dictionary:
		if inventory_panel and inventory_panel.socketing_workbench_panel:
			inventory_panel.socketing_workbench_panel.render_workbench_data(data)

	# 14. LPC 专属拾取与分解配置帧 (gfenjie)
	elif type == "gfenjie" and data is Dictionary:
		var action = str(data.get("action", ""))
		if action == "config" or action == "save_success":
			var cfg = data.get("config", {})
			if pickup_setting_panel and pickup_setting_panel.has_method("open_with_config"):
				pickup_setting_panel.open_with_config(cfg)
		elif action == "salvage_result":
			var it_name = str(data.get("item_name", "装备"))
			var rewards = data.get("rewards", {})
			var gold = _safe_int(rewards.get("gold"), 0)
			var dust = _safe_int(rewards.get("dust"), 0)
			_show_toast("自动分解【%s】获得: 金币+%d, 魔尘+%d" % [it_name, gold, dust])
			var sal_ids = data.get("salvaged_ids", [])
			if sal_ids is Array and inventory_panel and inventory_panel.has_method("update_item_amount"):
				for s_fid in sal_ids:
					inventory_panel.update_item_amount(str(s_fid), 0)

	# 15. LPC 专属随身补给商店帧 (gshop)
	elif type == "gshop" and data is Dictionary:
		if gshop_panel:
			gshop_panel.update_shop_data(data)
			if gshop_panel.visible:
				_position_gshop_panel()

	# 16. LPC 随身商店购买反馈帧 (gshop_msg)
	elif type == "gshop_msg" and data is Dictionary:
		var msg = str(data.get("msg", ""))
		if not msg.is_empty():
			_show_toast(msg)

	# 17. LPC 背包消息与满包警告反馈帧 (gbag_msg)
	elif type == "gbag_msg" and data is Dictionary:
		var msg = str(data.get("msg", ""))
		if not msg.is_empty():
			_show_toast(msg)

func _safe_int(val: Variant, default_val: int = 0) -> int:
	if val == null: return default_val
	if val is int: return val
	if val is float: return int(val)
	if val is String and val.is_valid_int(): return val.to_int()
	return default_val

## 处理服务端推送的交互面板帧 (组队邀请、操作确认等)
func _handle_panel_frame(data: Dictionary) -> void:
	var desc = str(data.get("desc", ""))
	var raw_actions = data.get("actions", [])
	var actions: Array = raw_actions if raw_actions is Array else []
	
	# 判定是否为组队邀请
	var is_team_invite = false
	var accept_cmd = ""
	var reject_cmd = "look"
	
	var clean_desc = AnsiHelper.to_plain_text(desc)
	if "邀请你加入" in clean_desc or "组队" in clean_desc:
		is_team_invite = true
		
	for act in actions:
		if act is Dictionary:
			var cmd = str(act.get("cmd", ""))
			var raw_lbl = str(act.get("label", act.get("name", "")))
			var clean_lbl = AnsiHelper.to_plain_text(raw_lbl).strip_edges()
			
			if cmd.begins_with("team with "):
				is_team_invite = true
				accept_cmd = cmd
			elif clean_lbl == "接受" and accept_cmd.is_empty():
				accept_cmd = cmd
			elif clean_lbl == "拒绝":
				reject_cmd = cmd
				
	if is_team_invite and not accept_cmd.is_empty():
		if team_invite_dialog:
			team_invite_dialog.show_invite(desc, accept_cmd, reject_cmd)
		return
		
	# 装备词缀展示兜底 (若 item_tooltip 处于开启状态且面板非组队，转交 tooltip 原地刷新)
	if item_tooltip and item_tooltip.visible:
		item_tooltip._on_network_json("panel", data)

func _on_text_received(text: String) -> void:
	var clean = AnsiHelper.to_plain_text(text).strip_edges()
	if clean.is_empty(): return
	
	# 排行榜文本包处理
	if "排行榜" in clean or "天下前" in clean or "武林" in clean:
		_render_leaderboard_text(text)
		return
		
	# 频道与聊天消息分流展示 (世界/队伍/交易/组队提示)
	if "『闲聊』" in clean or "闲聊" in clean:
		# LPC 闲聊频道即世界公频
		var raw_replaced = text.replace("闲聊", "世界")
		_append_chat(AnsiHelper.to_bbcode(raw_replaced), clean.replace("闲聊", "世界"))
	elif "『交易』" in clean:
		_append_chat(AnsiHelper.to_bbcode(text), clean)
	elif "【队伍】" in clean or "『队伍』" in clean:
		_append_chat(AnsiHelper.to_bbcode(text), clean)
	elif "『" in clean or "【" in clean or "说：" in clean or "告诉" in clean or "队伍" in clean:
		_append_chat(AnsiHelper.to_bbcode(text), clean)
	elif "加入队伍" in clean or "解散队伍" in clean or "组队" in clean:
		_append_chat("[color=#ffd700]" + clean + "[/color]", clean)
		_show_toast(clean)
	elif "队长带领全队踏入" in clean:
		_append_chat("[color=#38bdf8]⚔ " + clean + "[/color]", clean)
		_show_toast("队长已带队出征！正在跟随进入战斗位面...")
		await get_tree().create_timer(0.2).timeout
		get_tree().change_scene_to_file("res://scenes/afk/afk_main_hud.tscn")
	elif "你现在并没有和别人组成队伍" in clean or "不要在短期内使用频道发布重复的信息" in clean or "你必须在注册以后才能够使用" in clean or "你还没出生" in clean or "一句话说这么长" in clean:
		_append_chat("[color=#fbbf24]⚠️ " + clean + "[/color]", clean)
		_show_toast(clean)

## 城镇章节自适应
func _update_town_act(raw_title: String) -> void:
	var plain_name = AnsiHelper.to_plain_text(raw_title)
	if plain_name.is_empty(): plain_name = "罗格营地"
	_update_town_display(plain_name)

func _update_town_display(plain_name: String) -> void:
	current_room_name = plain_name
	
	for act_key in ACT_THEMES:
		var act_info = ACT_THEMES[act_key]
		if act_info.name in current_room_name:
			current_act_key = act_key
			bg_rect.color = act_info.bg
			camp_title.text = act_info.title
			camp_desc.text = act_info.desc
			lbl_room_title.text = "[center]【 [color=#4ade80]%s[/color] (安全区) 】[/center]" % act_info.name
			btn_go_battle.text = "⚔️ 出征野外挂机战斗 (前往 %s)" % act_info.exit_name
			break

var _last_room_refresh_time: int = 0
func _request_refresh_room() -> void:
	var now = Time.get_ticks_msec()
	if now - _last_room_refresh_time > 300:
		_last_room_refresh_time = now
		NetworkClient.send_raw("look")

## 解析同室玩家数据 (第一性原理：提取 hero 类型对象，杜绝储物箱等设施被误当玩家)
func _parse_room_players(objects_list: Array) -> void:
	room_players.clear()
	var my_name = lbl_char_name.text.strip_edges()
	var seen_ids = {}
	
	for obj in objects_list:
		if not obj is Dictionary: continue
		var raw_name = str(obj.get("name", ""))
		var clean_name = AnsiHelper.to_plain_text(raw_name)
		var ocmd = str(obj.get("cmd", ""))
		var rank = str(obj.get("rank", "normal"))
		var o_type = str(obj.get("type", "")).to_lower()
		
		# 1. 严格过滤非英雄对象：储物箱、传送小站、告示牌、魔盒、NPC等场景设施
		var is_facility = "箱" in clean_name or "小站" in clean_name or "stash" in ocmd or "waypoint" in ocmd or "cube" in ocmd or "牌" in clean_name or "石" in clean_name
		if is_facility or "npc" in ocmd or rank == "npc" or o_type == "npc":
			continue
			
		# 2. 必须具备英雄标志：明确的 type == "hero" / "player"，或者包含有效的职业/等级属性
		var has_hero_type = (o_type == "hero" or o_type == "player")
		var has_hero_props = (obj.has("class") or obj.has("d2_class") or obj.has("rating"))
		if not has_hero_type and not has_hero_props:
			continue
			
		# 提取英雄属性 (支持显式 class 与从 icon 反推职业)
		var p_id = str(obj.get("id", clean_name)).to_lower()
		if seen_ids.has(p_id):
			continue
		seen_ids[p_id] = true
		
		var p_cls = str(obj.get("class", obj.get("d2_class", ""))).to_lower()
		var p_icon = str(obj.get("icon", "")).to_lower()
		if p_cls.is_empty() or p_cls == "null":
			if "sorceress" in p_icon or "sor" in p_icon: p_cls = "sor"
			elif "paladin" in p_icon or "pal" in p_icon: p_cls = "pal"
			elif "necromancer" in p_icon or "nec" in p_icon: p_cls = "nec"
			elif "amazon" in p_icon or "ama" in p_icon: p_cls = "ama"
			elif "druid" in p_icon or "dru" in p_icon: p_cls = "dru"
			elif "assassin" in p_icon or "asn" in p_icon: p_cls = "asn"
			else: p_cls = "bar"
		var p_lvl = _safe_int(obj.get("level"), 1)
		var p_rating = str(obj.get("rating", "1.0k"))
		var raw_diff = str(obj.get("diff", obj.get("difficulty", "normal"))).to_lower()
		var p_diff = parse_difficulty_code(raw_diff)
		
		# 若名字自带 ANSI 难度色彩，也可辅以解析
		if p_diff == "normal":
			var esc = char(27)
			if (esc + "[1;31m") in raw_name or (esc + "[31m") in raw_name:
				p_diff = "hell"
			elif (esc + "[1;33m") in raw_name or (esc + "[33m") in raw_name:
				p_diff = "nm"
				
		var is_myself = (clean_name == my_name or p_id == GameState.player_id.to_lower())
		if is_myself and current_player_diff != "":
			p_diff = current_player_diff

		room_players.append({
			"id": p_id,
			"name": clean_name,
			"class": p_cls,
			"level": p_lvl,
			"rating": p_rating,
			"diff": p_diff,
			"cmd": ocmd,
			"is_self": is_myself
		})
		
	_render_player_cards()

## 设置难度过滤
func _set_diff_filter(filter: String) -> void:
	selected_diff_filter = filter
	
	btn_filter_all.add_theme_color_override("font_color", Color(1, 0.85, 0.4) if filter == "all" else Color(0.7, 0.7, 0.7))
	btn_filter_normal.add_theme_color_override("font_color", Color(1, 0.85, 0.4) if filter == "normal" else Color(0.7, 0.7, 0.7))
	btn_filter_nm.add_theme_color_override("font_color", Color(1, 0.85, 0.4) if filter == "nm" else Color(0.7, 0.7, 0.7))
	btn_filter_hell.add_theme_color_override("font_color", Color(1, 0.85, 0.4) if filter == "hell" else Color(0.7, 0.7, 0.7))
	
	_render_player_cards()

## 渲染同场景英雄长列表 (带滑动条)
func _render_player_cards() -> void:
	for c in player_list_vbox.get_children():
		c.queue_free()
		
	var displayed_count = 0
	
	for p in room_players:
		var p_diff = p["diff"]
		if selected_diff_filter != "all" and p_diff != selected_diff_filter:
			continue
			
		displayed_count += 1
		var card = _create_hero_card(p)
		player_list_vbox.add_child(card)
		
	lbl_player_count.text = "营地英雄 (%d 人)" % room_players.size()
	
	if displayed_count == 0:
		var empty_lbl = Label.new()
		empty_lbl.text = "当前筛选下无其他在线英雄"
		empty_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		empty_lbl.add_theme_color_override("font_color", Color(0.6, 0.6, 0.6, 0.8))
		empty_lbl.add_theme_font_size_override("font_size", 12)
		player_list_vbox.add_child(empty_lbl)

## 创建单个玩家的精致卡片
func _create_hero_card(p: Dictionary) -> PanelContainer:
	var card = PanelContainer.new()
	card.custom_minimum_size = Vector2(0, 52)
	
	var hbox = HBoxContainer.new()
	hbox.add_theme_constant_override("separation", 8)
	card.add_child(hbox)
	
	# 1. 职业专属头像
	var avatar = TextureRect.new()
	avatar.custom_minimum_size = Vector2(38, 38)
	avatar.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	avatar.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	avatar.texture = get_hero_avatar_icon(p["class"])
	hbox.add_child(avatar)
	
	# 2. 玩家信息 (名字、等级、战力、难度)
	var vbox_info = VBoxContainer.new()
	vbox_info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox_info.alignment = BoxContainer.ALIGNMENT_CENTER
	hbox.add_child(vbox_info)
	
	# 第 1 行：名字与等级
	var row1 = HBoxContainer.new()
	row1.add_theme_constant_override("separation", 6)
	vbox_info.add_child(row1)
	
	var name_lbl = Label.new()
	name_lbl.text = p["name"] + (" (你)" if p["is_self"] else "")
	name_lbl.add_theme_font_size_override("font_size", 13)
	name_lbl.add_theme_color_override("font_color", Color(0.95, 0.85, 0.55) if p["is_self"] else Color(0.9, 0.9, 0.9))
	row1.add_child(name_lbl)
	
	var lvl_lbl = Label.new()
	lvl_lbl.text = "Lv.%d" % p["level"]
	lvl_lbl.add_theme_font_size_override("font_size", 11)
	lvl_lbl.add_theme_color_override("font_color", Color(0.35, 0.85, 0.55))
	row1.add_child(lvl_lbl)
	
	# 第 2 行：战力徽章与难度标签
	var row2 = HBoxContainer.new()
	row2.add_theme_constant_override("separation", 8)
	vbox_info.add_child(row2)
	
	var rating_lbl = Label.new()
	rating_lbl.text = "⚔ " + str(p["rating"])
	rating_lbl.add_theme_font_size_override("font_size", 11)
	rating_lbl.add_theme_color_override("font_color", Color(1.0, 0.8, 0.2)) # 暗金
	row2.add_child(rating_lbl)
	
	var diff_info = get_difficulty_display(p["diff"])
	var diff_lbl = Label.new()
	diff_lbl.text = diff_info["label"]
	diff_lbl.add_theme_font_size_override("font_size", 11)
	diff_lbl.add_theme_color_override("font_color", diff_info["color"])
	row2.add_child(diff_lbl)
	
	# 3. 交互按钮组 (组队、交易、私聊)
	if not p["is_self"]:
		var btn_box = HBoxContainer.new()
		btn_box.add_theme_constant_override("separation", 4)
		btn_box.alignment = BoxContainer.ALIGNMENT_CENTER
		hbox.add_child(btn_box)
		
		# 组队按钮状态 (同难度可点；若已为队友则队长显示踢出，队员显示已入队)
		var is_same_diff = (p["diff"] == current_player_diff)
		var is_teammate = false
		for tm in GameState.current_team_members:
			if tm is Dictionary and str(tm.get("id", "")) == p["id"]:
				is_teammate = true
				break
				
		var btn_team = Button.new()
		btn_team.custom_minimum_size = Vector2(46, 26)
		
		if is_teammate:
			if GameState.is_team_leader():
				btn_team.text = "踢出"
				btn_team.add_theme_color_override("font_color", Color(0.95, 0.4, 0.4))
				btn_team.pressed.connect(func():
					_show_toast("已将【%s】移出队伍" % p["name"])
					NetworkClient.send_raw("team dismiss " + p["id"])
				)
			else:
				btn_team.text = "已入队"
				btn_team.disabled = true
				btn_team.add_theme_color_override("font_color", Color(0.4, 0.8, 1.0))
		else:
			btn_team.text = "组队"
			btn_team.disabled = not is_same_diff
			if not is_same_diff:
				btn_team.tooltip_text = "不同难度英雄不可组队"
			btn_team.pressed.connect(func():
				_show_toast("已向【%s】发起组队邀请！" % p["name"])
				NetworkClient.send_raw("team with " + p["id"])
			)
		btn_box.add_child(btn_team)
		
		# 交易按钮
		var btn_trade = Button.new()
		btn_trade.text = "交易"
		btn_trade.custom_minimum_size = Vector2(46, 26)
		btn_trade.pressed.connect(func():
			_show_toast("发起交易需双方并肩作战累计交易点！")
			NetworkClient.send_raw("trade " + p["id"])
		)
		btn_box.add_child(btn_trade)
		
		# 私聊按钮
		var btn_tell = Button.new()
		btn_tell.text = "私聊"
		btn_tell.custom_minimum_size = Vector2(46, 26)
		btn_tell.pressed.connect(func():
			chat_input.text = "/tell %s " % p["id"]
			chat_input.grab_focus()
			chat_input.caret_column = chat_input.text.length()
		)
		btn_box.add_child(btn_tell)
		
	return card

## 将装备插入聊天输入框 (支持拖入与 Shift+点击)
func _insert_item_to_chat(item_data: Dictionary) -> void:
	var raw_name = str(item_data.get("name", "装备"))
	var clean_name = AnsiHelper.to_plain_text(raw_name).strip_edges()
	var fid = str(item_data.get("file_id", item_data.get("id", "")))
	if fid.is_empty(): return
	
	var tag = "【%s】" % clean_name
	attached_item = {
		"file_id": fid,
		"name": clean_name,
		"tag": tag
	}
	
	# 在当前光标位置（或末尾）插入占位文字
	var col = chat_input.caret_column
	var cur_text = chat_input.text
	var before = cur_text.substr(0, col)
	var after = cur_text.substr(col)
	
	chat_input.text = before + tag + " " + after
	chat_input.grab_focus()
	chat_input.caret_column = (before + tag + " ").length()

## 聊天提交处理 (三频道：世界/队伍/交易 + 图文一体装备展示)
func _on_chat_submitted(text: String) -> void:
	var msg = text.strip_edges()
	if msg.is_empty(): return
	
	# 检查是否附带拖入/点击的装备
	if not attached_item.is_empty() and attached_item.get("tag", "") in msg:
		var fid = attached_item.get("file_id", "")
		NetworkClient.send_raw("gshowitem %s %s" % [fid, msg])
		attached_item.clear()
	elif msg.begins_with("/tell ") or msg.begins_with("/t "):
		NetworkClient.send_raw(msg.replace("/", ""))
	elif msg.begins_with("/show ") or msg.begins_with("gshowitem ") or msg.begins_with("showitem "):
		NetworkClient.send_raw(msg.replace("/", ""))
	else:
		var ch_idx = channel_select.selected if channel_select else 0
		var cmd_prefix = CHANNEL_CMDS.get(ch_idx, "chat")
		NetworkClient.send_raw("%s %s" % [cmd_prefix, msg])
		
	chat_input.text = ""

func _append_chat(bbcode_text: String, clean_snippet: String = "", record_to_global: bool = true) -> void:
	chat_log.append_text(bbcode_text + "\n")
	if record_to_global:
		GameState.add_chat_message(bbcode_text, clean_snippet)

## 点击公频聊天中的装备超链接
func _on_chat_meta_clicked(meta: Variant) -> void:
	var meta_str = str(meta).strip_edges()
	if meta_str.begins_with("item:"):
		var file_id = meta_str.substr(5)
		_inspect_chat_item(file_id)
	elif meta_str.begins_with("cmds:"):
		var cmd = meta_str.substr(5)
		if NetworkClient.is_connected:
			NetworkClient.send_raw(cmd)

## 跨空间查看装备高保真暗黑2悬浮卡片
func _inspect_chat_item(file_id: String) -> void:
	if item_tooltip:
		var mouse_pos = get_viewport().get_mouse_position()
		# 优先基于已有协议发起查询
		item_tooltip.show_item({ "file_id": file_id, "cmd": "glookitem " + file_id }, mouse_pos)
	if NetworkClient.is_connected:
		NetworkClient.send_raw("glookitem " + file_id)

func _unhandled_input(event: InputEvent) -> void:
	# 1. 焦点阻断：当玩家在输入框打字时，彻底屏蔽所有游戏操作热键（B/I/C/P/T等）
	var focus_owner = get_viewport().gui_get_focus_owner()
	if focus_owner is LineEdit or focus_owner is TextEdit:
		if event is InputEventKey and event.pressed and event.keycode == KEY_ESCAPE:
			focus_owner.release_focus()
			get_viewport().set_input_as_handled()
		return
		
	# 2. 键盘热键映射（仅在非打字状态下触发）
	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode == KEY_B or event.keycode == KEY_I:
			get_viewport().set_input_as_handled()
			_toggle_inventory()
			return
		elif event.keycode == KEY_C:
			get_viewport().set_input_as_handled()
			_toggle_character_info()
			return
		elif event.keycode == KEY_S:
			get_viewport().set_input_as_handled()
			_toggle_skill_panel()
			return
		elif event.keycode == KEY_X:
			get_viewport().set_input_as_handled()
			_toggle_cube_panel()
			return
		elif event.keycode == KEY_M:
			get_viewport().set_input_as_handled()
			_toggle_world_map()
			return
		elif event.keycode == KEY_P:
			get_viewport().set_input_as_handled()
			_toggle_pickup_setting()
			return
		elif event.keycode == KEY_F:
			get_viewport().set_input_as_handled()
			_on_enter_battle_pressed()
			return
		elif event.alt_pressed and event.keycode == KEY_Q:
			get_viewport().set_input_as_handled()
			toggle_sidebar()
			return
		elif event.keycode == KEY_ESCAPE:
			_close_all_popups_except(null)
			get_viewport().set_input_as_handled()
			return
		elif event.keycode == KEY_ENTER or event.keycode == KEY_KP_ENTER:
			# 回车快速激活聊天框
			chat_input.grab_focus()
			get_viewport().set_input_as_handled()
			return

	# 3. 鼠标空白处点击隐藏 Tooltip
	if event is InputEventMouseButton and event.pressed:
		if item_tooltip and item_tooltip.visible:
			var local_pos = item_tooltip.get_local_mouse_position()
			if not Rect2(Vector2.ZERO, item_tooltip.size).has_point(local_pos):
				item_tooltip.hide_tooltip()

## 出征野外挂机战斗 (无缝切换至 afk_main_hud)
func _on_enter_battle_pressed() -> void:
	if GameState.is_in_team and not GameState.is_team_leader():
		_show_toast("当前正处于队伍中，请等待队长带领全队统一出征！")
		return
		
	_show_toast("正在带领队伍出征，前往野外专属挂机位面...")
	if NetworkClient.is_connected:
		var st_id = _safe_int(GameState.current_stage_info.get("stage"), 1)
		# 若当前处于鲁高因及后续大幕，但关卡尚未跟进，自动对齐所属大幕首关
		if current_act_key == "act2" and st_id < 15:
			st_id = 15
		elif current_act_key == "act3" and st_id < 35:
			st_id = 35
		elif current_act_key == "act4" and st_id < 57:
			st_id = 57
		elif current_act_key == "act5" and st_id < 65:
			st_id = 65
		NetworkClient.send_raw("stage %d" % st_id)
		
	await get_tree().create_timer(0.2).timeout
	get_tree().change_scene_to_file("res://scenes/afk/afk_main_hud.tscn")

## 打开天梯排行榜弹窗
func _open_leaderboard() -> void:
	if toast_label: toast_label.visible = false
	leaderboard_modal.visible = true
	NetworkClient.send_raw("tops lvl")

func _close_leaderboard() -> void:
	leaderboard_modal.visible = false

func _render_leaderboard_text(raw_text: String) -> void:
	for c in rank_list_vbox.get_children():
		c.queue_free()
		
	var lines = raw_text.split("\n")
	for line in lines:
		var clean = AnsiHelper.to_plain_text(line).strip_edges()
		if clean.is_empty() or "---" in clean or "===" in clean:
			continue
			
		var lbl = Label.new()
		lbl.text = clean
		if "名次" in clean:
			lbl.add_theme_font_size_override("font_size", 14)
			lbl.add_theme_color_override("font_color", Color(1.0, 0.85, 0.35))
		else:
			lbl.add_theme_font_size_override("font_size", 13)
			if clean.begins_with("1 ") or clean.begins_with("1\t"):
				lbl.text = "🥇 " + clean
				lbl.add_theme_color_override("font_color", Color(1.0, 0.9, 0.4))
			elif clean.begins_with("2 ") or clean.begins_with("2\t"):
				lbl.text = "🥈 " + clean
				lbl.add_theme_color_override("font_color", Color(0.9, 0.92, 0.95))
			elif clean.begins_with("3 ") or clean.begins_with("3\t"):
				lbl.text = "🥉 " + clean
				lbl.add_theme_color_override("font_color", Color(0.9, 0.7, 0.45))
			else:
				lbl.add_theme_color_override("font_color", Color(0.8, 0.8, 0.8))
				
		rank_list_vbox.add_child(lbl)

## 退出到登录页
func _on_exit_to_login() -> void:
	if NetworkClient.is_connected:
		NetworkClient.send_raw("quit")
		await get_tree().create_timer(0.05).timeout
		NetworkClient.disconnect_server()
	GameState.reset_on_logout()
	get_tree().change_scene_to_file("res://scenes/login/login_screen.tscn")

## Toast 飘字提醒
func _show_toast(msg: String) -> void:
	toast_label.text = msg
	toast_label.visible = true
	await get_tree().create_timer(2.5).timeout
	if toast_label.text == msg:
		toast_label.visible = false

const CLASS_TO_AVATAR_NAME = {
	"ama": "amazon", "amazon": "amazon",
	"ass": "assassin", "asn": "assassin", "assassin": "assassin",
	"bar": "barbarian", "barbarian": "barbarian",
	"dru": "druid", "druid": "druid",
	"nec": "necromancer", "necromancer": "necromancer",
	"pal": "paladin", "paladin": "paladin",
	"sor": "sorceress", "sorceress": "sorceress"
}

## 辅助：获取职业头像
func get_hero_avatar_icon(cls: String) -> Texture2D:
	var clean_cls = cls.to_lower().strip_edges()
	var full_name = CLASS_TO_AVATAR_NAME.get(clean_cls, clean_cls)
	var path = "res://assets/avatars/%sicon.lowend.png" % full_name
	if ResourceLoader.exists(path):
		return load(path)
	return load("res://assets/avatars/sorceressicon.lowend.png")

## 辅助：解析难度代码
func parse_difficulty_code(diff: String) -> String:
	var d = diff.to_lower()
	if d in ["hell", "dy", "diyu"]:
		return "hell"
	elif d in ["nightmare", "nm", "em", "emeng"]:
		return "nm"
	return "normal"

## 辅助：难度展示信息
func get_difficulty_display(diff_code: String) -> Dictionary:
	if diff_code == "hell":
		return { "label": "【地狱】", "name": "地狱", "color": Color(1.0, 0.35, 0.35) }
	elif diff_code == "nm":
		return { "label": "【噩梦】", "name": "噩梦", "color": Color(1.0, 0.85, 0.1) }
	return { "label": "【普通】", "name": "普通", "color": Color(0.85, 0.9, 0.95) }

## 辅助：纯后端数据驱动更新顶栏等级显示
func _update_topbar_level(new_lvl: int) -> void:
	if lbl_char_class and new_lvl > 0:
		var raw = lbl_char_class.text.strip_edges()
		var parts = raw.split(" ")
		var cls_suffix = parts[1] if parts.size() >= 2 else "英雄"
		lbl_char_class.text = "Lv.%d %s" % [new_lvl, cls_suffix]
