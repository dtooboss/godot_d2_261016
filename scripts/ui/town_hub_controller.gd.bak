extends Control

## 暗黑破坏神2 主城安全区大本营控制器 (TownHubController)
## 全面支持 Act 1 ~ Act 5 进度自适应进驻、纯战网集结社交、同室英雄列表、同难度组队、交易、聊天与排行榜

# 顶部导航
@onready var lbl_room_title: RichTextLabel = $TopBar/HBox/RoomTitleLabel
@onready var lbl_char_name: Label = $TopBar/HBox/CharInfoBox/CharNameLabel
@onready var lbl_char_class: Label = $TopBar/HBox/CharInfoBox/CharClassLabel
@onready var lbl_gold: Label = $TopBar/HBox/ResourceBox/GoldLabel
@onready var avatar_icon: TextureRect = $TopBar/HBox/AvatarRect
@onready var btn_top_rank: Button = $TopBar/HBox/ResourceBox/BtnTopRank
@onready var btn_top_exit: Button = $TopBar/HBox/ResourceBox/BtnTopExit

# 中央大本营与出征
@onready var camp_title: Label = %CampTitle
@onready var camp_desc: Label = %CampDesc
@onready var btn_go_battle: Button = %BtnGoBattle
@onready var btn_stash: Button = %BtnStash
@onready var btn_waypoint: Button = %BtnWaypoint
@onready var btn_cube: Button = %BtnCube

# 聊天系统 (三频道：世界/队伍/交易)
@onready var chat_log: RichTextLabel = $MainLayout/LeftArea/ChatPanel/VBox/ChatLog
@onready var channel_select: OptionButton = $MainLayout/LeftArea/ChatPanel/VBox/HBox/ChannelSelect
@onready var chat_input: LineEdit = $MainLayout/LeftArea/ChatPanel/VBox/HBox/ChatInput
@onready var btn_chat_send: Button = $MainLayout/LeftArea/ChatPanel/VBox/HBox/BtnChatSend

var attached_item: Dictionary = {} # 当前拖入/附带展示的装备元数据

const CHANNEL_CMDS = {
	0: "chat", # 世界 (走 channeld 闲聊频道)
	1: "tt",   # 队伍 (走 team talk)
	2: "bill"  # 交易 (走 channeld 交易频道)
}

# 营地英雄与组队中心 (常驻大本营顶部，带滑动与难度过滤)
@onready var heroes_panel: PanelContainer = %HeroesPanel
@onready var lbl_player_count: Label = %PlayerCountLabel
@onready var btn_filter_all: Button = %BtnFilterAll
@onready var btn_filter_normal: Button = %BtnFilterNormal
@onready var btn_filter_nm: Button = %BtnFilterNm
@onready var btn_filter_hell: Button = %BtnFilterHell
@onready var player_scroll: ScrollContainer = %PlayerScroll
@onready var player_list_vbox: VBoxContainer = %PlayerListVBox

# 右侧边栏工作台 (挂机房同款: 背包 + 控制矩阵 + 缩进按钮)
@onready var right_sidebar: Control = %RightSidebar
@onready var inventory_panel: AFK_PlayerInventoryPanel = %PlayerInventoryPanel
@onready var control_matrix: AFK_ControlMatrixPanel = %ControlMatrixPanel
@onready var btn_toggle_sidebar: Button = %BtnToggleSidebar
var is_sidebar_expanded: bool = true

# 弹窗与视窗
@onready var toast_label: Label = $ToastLabel
@onready var bg_rect: ColorRect = $Background
@onready var leaderboard_modal: Control = $LeaderboardModal
@onready var btn_close_rank: Button = $LeaderboardModal/CenterContainer/Panel/VBox/BtnCloseRank
@onready var rank_list_vbox: VBoxContainer = $LeaderboardModal/CenterContainer/Panel/VBox/Scroll/RankListVBox
@onready var item_tooltip: AFK_ItemTooltip = $ItemTooltip
@onready var team_invite_dialog: Control = get_node_or_null("TeamInviteDialog")
@onready var world_map: AFK_WorldMap = get_node_or_null("WorldMap")
@onready var char_info_panel: Control = get_node_or_null("CharacterInfoPanel")
@onready var skill_panel: AFK_SkillPanel = get_node_or_null("SkillPanel")
@onready var pickup_setting_panel: Control = get_node_or_null("PickupSettingPanel")
var cube_panel: AFK_CubePanel = null
const GShopPanelScript = preload("res://scenes/afk/components/gshop_panel.gd")
var gshop_panel: Control = null

# 城镇主题自适应
