				{"name": "项链/戒指", "key": "magic_jewelry"}
			]
		},
		{
			"id": "rare",
			"name": "稀有",
			"color": Color(1.0, 1.0, 0.39), # 亮金
			"sub_types": [
				{"name": "武器", "key": "rare_weapon"},
				{"name": "大件防具", "key": "rare_armor"},
				{"name": "手套/鞋子", "key": "rare_boots_gloves"},
